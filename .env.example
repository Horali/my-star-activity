# Copy this file to .env and fill in the values. Never commit .env.
# Application ID from the Discord Developer Portal (General Information page).
CLIENT_ID=
# Bot token from the Bot page of the same application. Used only to read my_star's avatar.
BOT_TOKEN=
# my_star's user ID (Developer Mode on, right-click their name, Copy User ID).
FRIEND_ID=
# Horaya's public web address (the host's URL with port), for the /mystar toggle. Empty = card always on.
HORAYA_URL=
# Same value as MYSTAR_SECRET in Horaya's host .env.
MYSTAR_SECRET=
